{
  "name": "@local/dsh-douyin-fish",
  "version": "0.8.0-dev.19",
  "private": true,
  "type": "module",
  "description": "大肥鱼控制台：主人与指定单聊自动回复、兴趣筛选原生卡片分享和评论、可编辑人设、真实账单与专用Edge运行控制。",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "config",
    "console",
    "locale",
    "personas",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MATH-1-ZERO/dsh-douyin-fish.git"
  },
  "homepage": "https://github.com/MATH-1-ZERO/dsh-douyin-fish#readme",
  "bugs": {
    "url": "https://github.com/MATH-1-ZERO/dsh-douyin-fish/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-release.mjs"
  },
  "main": "./src/index.js"
}
